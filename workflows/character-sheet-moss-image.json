{
  "unet": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "moss_image_sft_int8_convrot.safetensors",
      "weight_dtype": "default"
    },
    "_meta": {
      "title": "MOSS-Image"
    }
  },
  "clip": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen3.5_9b_w4a8_gptq.safetensors",
      "type": "moss_image",
      "device": "default"
    },
    "_meta": {
      "title": "Text encoder"
    }
  },
  "vae": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "flux2-vae_small.safetensors"
    },
    "_meta": {
      "title": "VAE"
    }
  },
  "text": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": [
        "clip",
        0
      ],
      "text": "A photorealistic character sheet of one fully clothed character in two side-by-side panels of equal size on a plain light-grey studio background. Right panel: a full-length front view from head to feet. Left panel: an extreme close-up portrait of the same character. Describe the character here."
    },
    "_meta": {
      "title": "Prompt"
    }
  },
  "negative": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": [
        "clip",
        0
      ],
      "text": "nsfw, worst quality, bad anatomy, watermark, jpeg artifact"
    },
    "_meta": {
      "title": "Negative"
    }
  },
  "latent": {
    "class_type": "EmptyFlux2LatentImage",
    "inputs": {
      "width": 1664,
      "height": 1248,
      "batch_size": 1
    },
    "_meta": {
      "title": "Size"
    }
  },
  "sample": {
    "class_type": "KSampler",
    "inputs": {
      "model": [
        "unet",
        0
      ],
      "positive": [
        "text",
        0
      ],
      "negative": [
        "negative",
        0
      ],
      "latent_image": [
        "latent",
        0
      ],
      "seed": 42,
      "steps": 25,
      "cfg": 2.5,
      "sampler_name": "er_sde",
      "scheduler": "simple",
      "denoise": 1
    },
    "_meta": {
      "title": "Sampler"
    }
  },
  "decode": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "sample",
        0
      ],
      "vae": [
        "vae",
        0
      ]
    },
    "_meta": {
      "title": "Decode"
    }
  },
  "save": {
    "class_type": "SaveImage",
    "inputs": {
      "images": [
        "decode",
        0
      ],
      "filename_prefix": "studio"
    },
    "_meta": {
      "title": "Save"
    }
  }
}
